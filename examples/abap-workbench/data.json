  "questions": [
    {
      "id": "q1",
      "q": "What does ZCL_ORDER_HANDLER do?",
      "calls": [
        {
          "tool": "SAPContext",
          "args": "{\"action\":\"deps\",\"type\":\"CLAS\",\"name\":\"ZCL_ORDER_HANDLER\"}",
          "result": "KTD found; 2 dependencies (ZCL_ORDER_VALIDATOR, ZTB_ORDER_LOG)"
