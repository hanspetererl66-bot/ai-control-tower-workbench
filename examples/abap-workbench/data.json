  "sources": {
    "ZCL_ORDER_HANDLER": [
      "CLASS zcl_order_handler IMPLEMENTATION.",
      "",
      "  METHOD validate_order.",
      "    DATA(lo_validator) = NEW zcl_order_validator( ).",
      "    rv_valid = lo_validator->check( is_order ).",
      "  ENDMETHOD.",
      "",
      "  METHOD book_order.",
      "    IF validate_order( is_order ) = abap_false.",
      "      RAISE EXCEPTION TYPE zcx_order_invalid.",
      "    ENDIF.",
      "    INSERT ztb_order_log FROM @( VALUE #( order_id = is_order-order_id",
      "                                          status   = 'B' ) ).",
      "  ENDMETHOD.",
      "",
      "ENDCLASS."
    ],
    "ZI_SALESORDER": [
      "@AccessControl.authorizationCheck: #CHECK",
      "@EndUserText.label: 'Sales Order Interface View'",
      "define root view entity ZI_SalesOrder",
      "  as select from zsalesorder",
      "{",
      "  key order_id   as OrderId,",
      "      customer   as Customer,",
      "      net_amount as NetAmount,",
      "      currency   as Currency",
      "}"
    ],
    "ZORDER_REPORT": [
      "REPORT zorder_report.",
      "",
      "START-OF-SELECTION.",
      "  SELECT order_id, customer, net_amount",
      "    FROM zi_salesorder",
      "    INTO TABLE @DATA(lt_orders).",
      "",
      "  cl_salv_table=>factory( IMPORTING r_salv_table = DATA(lo_alv)",
      "                          CHANGING  t_table      = lt_orders ).",
      "  lo_alv->display( )."
    ]
  },
