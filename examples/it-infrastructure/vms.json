  "tasks": {
    "cert": {
      "title": "Renew TLS certificate",
      "steps": [
        "Create the signing request",
        "Check the chain and the services that use the certificate",
        "Install in the maintenance window after approval"
      ],
      "reboot": false,
      "approver": "Security",
      "fix": {
        "certExpiresInDays": 365
      }
    },
    "patch": {
      "title": "Install security patch",
      "steps": [
        "Check maintenance window and redundancy",
        "Patch the twin or standby first",
        "Restart and run the health check"
      ],
      "reboot": true,
      "approver": "Change board",
      "fix": {
        "patchLagDays": 0,
        "uptimeDays": 0
      }
    },
    "disk": {
      "title": "Free up disk space",
      "steps": [
        "Find the largest directories and old logs",
        "Propose archive, clean-up or resize",
        "Run after approval, then measure again"
      ],
      "reboot": false,
      "approver": "Service owner",
      "fix": {
        "diskPct": 61
      }
    },
    "backup": {
      "title": "Catch up the backup",
      "steps": [
        "Check the backup job and its last error",
        "Start a backup run",
        "Verify the restore point"
      ],
      "reboot": false,
      "approver": "Backup owner",
      "fix": {
        "backupAgeHours": 1
      }
    },
    "unreachable": {
      "title": "Check an unreachable VM",
      "steps": [
        "Ping, port and hypervisor status",
        "Look at the console and recent changes",
        "Propose a restart, never restart without approval"
      ],
      "reboot": true,
      "approver": "On-call",
      "fix": {
        "reachable": true,
        "cpuPct": 20,
        "memPct": 35,
        "diskPct": 40,
        "uptimeDays": 0
      }
    },
    "cpu": {
      "title": "Analyse the CPU peak",
      "steps": [
        "Find the process behind the peak",
        "Compare with the twin VM",
        "Propose scaling or a fix, with approval"
      ],
      "reboot": false,
      "approver": "Service owner",
      "fix": {
        "cpuPct": 45
      }
    },
    "mem": {
      "title": "Check memory pressure",
      "steps": [
        "List the largest memory users",
        "Look for leaks and restart candidates",
        "Propose a restart or more RAM, with approval"
      ],
      "reboot": false,
      "approver": "Service owner",
      "fix": {
        "memPct": 60
      }
    }
  }
