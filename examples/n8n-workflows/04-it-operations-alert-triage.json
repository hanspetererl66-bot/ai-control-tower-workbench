            {
              "id": "dc2a4776-a967-5358-b068-cae5513a01d2",
              "name": "priority",
              "value": "={{ 0 }}",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "1cfdac48-7bd4-5a63-b9b9-4ce93785229c",
      "name": "Quarantine",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1040,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Transparent priority points (0 to 100). Every point has a reason; nothing is guessed.\nconst SEV = { critical: 40, high: 28, medium: 14, low: 4 };\nconst IMPACT = { high: 25, medium: 12, low: 3 };\nreturn $input.all().map(({ json }) => {\n  const reasons = [];\n  let points = 0;\n  const add = (p, why) => { if (p) { points += p; reasons.push(`+${p} ${why}`); } };\n  add(SEV[json.severity] ?? 0, `severity ${json.severity}`);\n  add(IMPACT[json.impact] ?? 0, `business impact ${json.impact}`);\n  add(json.customerFacing ? 20 : 0, 'customer facing');\n  add(Math.min(15, (json.repeat24h || 0) * 5), `repeated ${json.repeat24h || 0}x in 24 h`);\n  const priority = Math.min(100, points);\n  return { json: { ...json, priority, reasons: reasons.join('; ') } };\n});"
      },
