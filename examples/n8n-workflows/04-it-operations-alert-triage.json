    {
      "parameters": {
        "jsCode": "// Digest for the IT operations round. Ends in \"draft, never execute\": a person decides about paging, tickets and restarts.\nconst items = $input.all().map((i) => i.json);\nconst by = (r) => items.filter((i) => String(i.route).startsWith(r)).sort((a, b) => b.priority - a.priority);\nconst line = (i) => `- ${i.id} ${i.service} (priority ${i.priority}): ${i.text}${i.reasons ? ` [${i.reasons}]` : ''}`;\nconst p1 = by('P1'), p2 = by('P2'), p3 = by('P3'), q = by('Quarantined');\nconst text = [\n  `IT operations digest, ${items.length} alerts`,\n  `P1 page on-call (${p1.length}):`, ...p1.map(line),\n  `P2 open a ticket (${p2.length}):`, ...p2.map(line),\n  `P3 watch (${p3.length}):`, ...p3.map(line),\n  `Quarantined (${q.length}):`, ...q.map((i) => `- ${i.id} ${i.service}: ${i.flagReason}`),\n  'Draft only. Nothing was paged, restarted or changed. A person decides.',\n].join('\\n');\nreturn [{ json: { counts: { p1: p1.length, p2: p2.length, p3: p3.length, quarantined: q.length }, digest: text } }];"
      },
      "id": "cdb1bcd6-816d-5875-9369-a7bce145be6c",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
