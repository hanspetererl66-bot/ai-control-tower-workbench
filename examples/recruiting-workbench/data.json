    "briefs": {
      "REQ-2201": {
        "role": "You lead a shift of about twenty people in the Hamburg warehouse: planning the shift, keeping inbound and outbound on time, and coaching the team."
      },
      "REQ-2202": {
        "role": "You load, unload and move goods safely in the Bremen warehouse and keep your equipment checked and clean."
      },
      "REQ-2203": {
        "role": "You turn planning data into forecasts and clear recommendations for the supply chain planners in Hamburg."
      },
      "REQ-2204": {
        "role": "You advise internal teams on SAP logistics processes and deliver changes from design to go-live."
      },
      "REQ-2205": {
        "role": "You answer customer questions by phone and e-mail in German and English and solve them on the first contact where you can."
      },
      "REQ-2206": {
        "role": "You run the monthly payroll for our sites in Hamburg and answer payroll questions from employees."
      }
    }
