# Copy to .env (same folder). start.sh loads it on every start; .env is git-ignored.
# Hugging Face read token (https://huggingface.co/settings/tokens). Not needed if you ran `hf auth login` once.
HF_TOKEN=
# auto = TabPFN if it loads, else the labelled baseline. tabpfn = fail instead of falling back. baseline = never load TabPFN.
TABPFN_ENGINE=auto
# Optional bearer token the connector must send (set the same value in the connector).
TABPFN_SERVICE_TOKEN=
PORT=8808
