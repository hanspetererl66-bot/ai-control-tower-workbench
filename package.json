{
  "name": "werkbank",
  "version": "0.1.0",
  "description": "A local AI workbench for conversations, files, Spaces, connectors, and skills.",
  "private": true,
  "main": "electron/main.mjs",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "phase0": "node --env-file=.env spike.mjs",
    "dev": "vite --port 5273 & electron .",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "sync:design": "node scripts/sync-design-system.mjs",
    "sync:control-tower": "node scripts/sync-control-tower-data.mjs",
    "sync:skill-marketplace": "node scripts/sync-skill-marketplace.mjs",
    "sync:skill-ratings": "node scripts/sync-skill-ratings.mjs",
    "sync:skill-profiles": "node scripts/sync-skill-profiles.mjs",
    "sync:sub4me": "node scripts/sync-sub4me.mjs",
    "sync:knowledge-graph": "node scripts/sync-knowledge-graph.mjs",
    "sync:agent-activity": "node scripts/sync-agent-activity.mjs",
    "sync:mockups": "node scripts/sync-mockup-spaces.mjs",
    "sync:infra-ops": "node scripts/sync-infra-ops.mjs",
    "sync:calm-alm": "node scripts/sync-calm-alm.mjs",
    "sync:automation": "node scripts/sync-automation-dashboard.mjs",
    "build:control-tower-mcpb": "node scripts/build-control-tower-mcpb.mjs",
    "build:gmail-mcpb": "node scripts/build-control-tower-mcpb.mjs --gmail",
    "gmail:authorize": "node scripts/gmail-authorize.mjs",
    "install:control-tower": "node scripts/install-example-space.mjs control-tower",
    "install:sub4me": "node scripts/install-example-space.mjs sub4me",
    "install:skill-marketplace": "node scripts/install-example-space.mjs skill-marketplace",
    "install:automation": "node scripts/install-example-space.mjs automation-dashboard",
    "install:knowledge-graph": "node scripts/install-example-space.mjs knowledge-graph",
    "install:agent-activity": "node scripts/install-example-space.mjs agent-activity",
    "install:call-transcripts": "node scripts/install-example-space.mjs call-transcripts",
    "install:customer-emails": "node scripts/install-example-space.mjs customer-emails",
    "install:infra-ops": "node scripts/install-example-space.mjs infra-ops",
    "install:calm-alm": "node scripts/install-example-space.mjs calm-alm",
    "install:sales": "node scripts/install-example-space.mjs sales",
    "install:skills": "node scripts/install-example-skills.mjs",
    "skills": "node scripts/skills-registry.mjs",
    "skills:sync": "node scripts/skills-registry.mjs sync",
    "skills:publish": "node scripts/skills-registry.mjs publish",
    "install:examples": "node scripts/install-example-space.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ai",
    "desktop",
    "mcp",
    "agents",
    "goose"
  ],
  "author": "Marian Zeis",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/marianfoo/werkbank.git"
  },
  "bugs": {
    "url": "https://github.com/marianfoo/werkbank/issues"
  },
  "homepage": "https://getwerkbank.com/",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "dependencies": {
    "@aaif/goose-sdk": "^0.20.2",
    "@agentclientprotocol/sdk": "^0.19.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
