{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge feeder source registry",
  "type": "object",
  "required": ["version", "sources"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "note": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "owner", "url", "kind", "license", "terms_url", "status", "reason", "attribution_text", "dataset", "id_prefix", "checked_on"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "kind": { "enum": ["git-org", "git-repo", "feed", "page"] },
          "license": { "type": "string", "description": "SPDX id, 'per-repo' (read from each repository) or 'unknown'" },
          "terms_url": { "type": "string", "pattern": "^https://" },
          "status": { "enum": ["allowed", "metadata_only", "needs_review", "blocked"] },
          "reason": { "type": "string", "minLength": 1 },
          "attribution_text": { "type": "string" },
          "dataset": { "type": "string", "description": "Cognee dataset; empty for blocked and needs_review" },
          "id_prefix": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "feeds": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
          "feeds_file": { "type": "string" },
          "checked_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
