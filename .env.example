# Copy to .env and fill in.
OPENROUTER_API_KEY=
# Vision + tool calling are both required for picture attachments and connectors.
GOOSE_MODEL=openai/gpt-4.1-mini

# Optional local ARC-1 / Phase 0 configuration. Keep write scopes narrow.
SAP_URL=
SAP_USER=
SAP_PASSWORD=
SAP_CLIENT=001
SAP_LANGUAGE=EN
SAP_INSECURE=false
SAP_ALLOW_WRITES=false
SAP_ALLOWED_PACKAGES=$TMP
SAP_ALLOW_DATA_PREVIEW=false
SAP_ALLOW_FREE_SQL=false
SAP_ALLOW_TRANSPORT_WRITES=false
SAP_ALLOW_GIT_WRITES=false
